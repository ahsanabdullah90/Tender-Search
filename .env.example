# Server network binding (defaults to local loopback for security)
# PORT=3000
# HOST=127.0.0.1

# Runtime mode: development | production | test
# NODE_ENV=development

# Optional override for database, backups, dossiers, logs, models, tessdata, sessions, and app-profile.
# Leave unset to use ./data. Set to data-sample to run on isolated sample data (see npm run seed:sample).
# TENDER_DATA_DIR=data

# Optional Google Gemini API key fallback (can also be configured via Sources & Keywords > Data in SQLite).
# GEMINI_API_KEY=

# Optional per-session secret injected by scripts/tray-app.ps1 to authorize POST /api/system/shutdown.
# Leave unset for standard CLI/dev runs (keeps the shutdown endpoint disabled with HTTP 403).
# TENDER_SHUTDOWN_TOKEN=
